# .env.example — скопировать в .env и заполнить
NODE_ENV=development
PORT=3000
# Локальный PostgreSQL: postgresql://пользователь:пароль@сервер:5432/база
DATABASE_URL=postgresql://postgres:ВАШ_ПАРОЛЬ@localhost:5432/traintix
JWT_SECRET=замените-на-длинную-случайную-строку-минимум-32-символа
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
APP_TIMEZONE=Europe/Prague
APP_URL=http://localhost:5173
# Почта. Если SMTP_HOST пустой — письма не отправляются, а сохраняются в папку server/dev-mails (удобно для разработки).
# Для Mailpit: SMTP_HOST=localhost SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="TrainTix <no-reply@traintix.local>"
SEED_ADMIN_PASSWORD=Admin12345
# Необязательно: путь к TTF-шрифту с кириллицей для PDF-билетов
PDF_FONT=
